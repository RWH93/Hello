{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hello",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory":"cloudflare/public","binding":"ASSETS","run_worker_first":true},
  "durable_objects":{"bindings":[{"name":"DIARY","class_name":"BookingDiary"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["BookingDiary"]}],
  "keep_vars": true,
  "vars": {"PUBLIC_ORIGIN":"https://hello.ryanhartle.workers.dev"},
  "build":{"command":"node cloudflare/prepare.mjs"}
}
